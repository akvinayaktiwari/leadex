# Fargate image for the queue worker (default CMD) and the scheduled ingest task (CMD node ingest.mjs).
# Build context: repository root.
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY backend/package.json backend/package.json
COPY frontend/package.json frontend/package.json
COPY infra/package.json infra/package.json
RUN npm ci --workspace backend --include-workspace-root=false
COPY tsconfig.base.json ./
COPY backend backend
RUN npm run build:worker --workspace backend && npm run build:ingest --workspace backend

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/backend/dist/worker.mjs ./worker.mjs
COPY --from=build /app/backend/dist/ingest.mjs ./ingest.mjs
USER node
CMD ["node", "worker.mjs"]
