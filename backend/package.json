{
  "name": "@leadex/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/dev-server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run build:api && npm run build:stream && npm run build:worker",
    "build:api": "esbuild index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.mjs --external:@aws-sdk/*",
    "build:stream": "esbuild stream.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/stream.mjs --external:@aws-sdk/*",
    "build:worker": "esbuild worker.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/worker.mjs --banner:js=\"import { createRequire as __leadexCreateRequire } from 'module'; const require = __leadexCreateRequire(import.meta.url);\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@aws-sdk/client-dynamodb": "^3.1154.0",
    "@aws-sdk/client-sqs": "^3.1153.0",
    "@aws-sdk/lib-dynamodb": "^3.1154.0",
    "@hono/node-server": "^2.1.5",
    "@sentry/node": "^11.8.0",
    "cheerio": "^1.2.0",
    "hono": "^4.13.13",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
