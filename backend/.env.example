# Copy to backend/.env for local development. Never commit real values.

# Core
AWS_REGION=ap-south-1
FRONTEND_URL=http://localhost:3000
PIPELINE_VERSION=1
PORT=8787
LEAD_BUILDS_ENABLED=false
SENTRY_DSN=

# Queue (worker + API enqueue)
SQS_RUNS_QUEUE_URL=

# DynamoDB tables
# Local only: point at DynamoDB Local (docker run -p 8000:8000 amazon/dynamodb-local:2.6.1). Leave unset in AWS.
DYNAMODB_ENDPOINT=
TABLE_USERS=
TABLE_ANALYSES=
TABLE_RUNS=
TABLE_RUN_EVENTS=
TABLE_LEADS=
TABLE_CREDIT_LEDGER=
TABLE_INTEGRATIONS=
TABLE_RATE_LIMITS=

# Encryption
KMS_KEY_ID=

# Auth (Cognito)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# AI
ANTHROPIC_API_KEY=
# Model ids are config. LLM_MODEL_FAST runs the per-analysis steps (profile, competitors);
# set it to a cheaper model (e.g. claude-haiku-5-5) if cost per analysis matters more than quality.
LLM_MODEL_SMART=claude-opus-5-5
LLM_MODEL_FAST=claude-opus-5-5

# Leadex Data (own lead database, ClickHouse)
# Local: docker run -d -p 8123:8123 -e CLICKHOUSE_USER=leadex -e CLICKHOUSE_PASSWORD=leadex \
#   -e CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1 clickhouse/clickhouse-server:25.8.33.6
# then: npm run migrate:clickhouse --workspace backend
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=leadex
CLICKHOUSE_PASSWORD=leadex
CLICKHOUSE_DATABASE=leadex_dev
# Scheduled imports (leadex-ingest). Off unless exactly "true".
INGEST_ENABLED=false
# Company discovery (#22): Common Crawl domain-level ranks file of the release to import (new release each quarter,
# listed at https://commoncrawl.org/web-graphs), and how many top domains to keep after filtering.
CC_DOMAIN_RANKS_URL=https://data.commoncrawl.org/projects/hyperlinkgraph/cc-main-2026-apr-may-jun/domain/cc-main-2026-apr-may-jun-domain-ranks.txt.gz
INGEST_CC_MAX_DOMAINS=2000000
# Company profiler (#22): domains crawled and profiled per run. 0 = off. Needs ANTHROPIC_API_KEY, LLM_MODEL_FAST
# and FRONTEND_URL (crawler user agent). Measure cost first: npm run profile:sample --workspace backend -- --limit 1000
INGEST_PROFILE_MAX_PER_RUN=0
INGEST_PROFILE_CONCURRENCY=8
# Optional: USD per million input / output tokens of LLM_MODEL_FAST, so runs log a cost.
LLM_FAST_INPUT_USD_PER_MTOK=
LLM_FAST_OUTPUT_USD_PER_MTOK=
# GLEIF legal entities (#22): import the LEI golden copy (full file monthly, last-day delta daily; CC0 licence) and match
# profiled companies' legal names to it. Leave GLEIF_API_URL empty to turn both jobs off.
GLEIF_API_URL=https://goldencopy.gleif.org/api/v2/golden-copies/publishes/latest
GLEIF_RECORD_URL_BASE=https://search.gleif.org/#/record/
INGEST_GLEIF_MATCH_PER_RUN=5000
# People from company websites (#23): profiled companies whose team/about/contact pages are read per run. 0 = off.
# Needs the same model settings as the profiler. Measure first: npm run people:sample --workspace backend -- --limit 200
INGEST_PEOPLE_MAX_PER_RUN=0
INGEST_PEOPLE_CONCURRENCY=8

# Optional fallbacks, off by default (#25, #24)
DATA_VENDOR_FALLBACK=none
PDL_API_KEY=
EMAIL_VERIFIER_FALLBACK=none
ZEROBOUNCE_API_KEY=

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Abuse protection
TURNSTILE_SECRET=
