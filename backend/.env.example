# Copy to backend/.env for local development. Never commit real values.

# Core
AWS_REGION=ap-south-1
FRONTEND_URL=http://localhost:3000
PIPELINE_VERSION=1
PORT=8787
LEAD_BUILDS_ENABLED=false
SENTRY_DSN=

# Queue (worker + API enqueue)
SQS_RUNS_QUEUE_URL=

# DynamoDB tables
# Local only: point at DynamoDB Local (docker run -p 8000:8000 amazon/dynamodb-local:2.6.1). Leave unset in AWS.
DYNAMODB_ENDPOINT=
TABLE_USERS=
TABLE_ANALYSES=
TABLE_RUNS=
TABLE_RUN_EVENTS=
TABLE_LEADS=
TABLE_CREDIT_LEDGER=
TABLE_INTEGRATIONS=
TABLE_RATE_LIMITS=

# Encryption
KMS_KEY_ID=

# Auth (Cognito)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# AI
ANTHROPIC_API_KEY=
LLM_MODEL_SMART=
LLM_MODEL_FAST=

# Lead data
PDL_API_KEY=
HUNTER_API_KEY=
PROSPEO_API_KEY=
FINDYMAIL_API_KEY=
ZEROBOUNCE_API_KEY=

# Lead cache
CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Abuse protection
TURNSTILE_SECRET=
