# Copy to frontend/.env.local for local development.
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_STREAM_URL=http://localhost:8787
# Cloudflare Turnstile site key. Local: 1x00000000000000000000AA always passes (pair it with the test secret in backend/.env).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
